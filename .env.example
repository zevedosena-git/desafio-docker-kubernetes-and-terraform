# Copie para .env (ignorado pelo Git) e preencha as senhas.
# Compose: sem caracteres reservados de URL (@ : / ? # %), a DATABASE_URL é montada a partir destes valores.
# Com eles, defina também DATABASE_URL com usuário e senha codificados (percent-encoding).
POSTGRES_USER=mural
POSTGRES_DB=mural
POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://mural:<senha-codificada>@db:5432/mural?sslmode=disable

# Terraform: use a mesma senha em todos os apply e no destroy.
TF_VAR_postgres_password=
